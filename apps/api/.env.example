PORT=4000

# DATABASE_URL should match what is already in packages/db/.env
DATABASE_URL=""

# Secret used to sign and verify workspace-scoped JWTs
JWT_SECRET=""

# 32-byte hex key for symmetric AES-256-GCM token encryption (must be different from JWT_SECRET)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Meta webhook verification handshake token (configured in Meta App Dashboard)
META_WEBHOOK_VERIFY_TOKEN=""

# Meta App Secret for X-Hub-Signature-256 HMAC verification (Meta App Dashboard > Settings > Basic)
META_APP_SECRET=""

