generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("trial")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  contacts    Contact[]
  channels    Channel[]
  templates   Template[]
  campaigns     Campaign[]
  conversations Conversation[]
  messages      Message[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        String   @default("agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Contact {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  phone       String
  email       String?
  name        String?
  attributes  Json?
  optedInAt   DateTime? @map("opted_in_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  campaignRecipients CampaignRecipient[]
  conversations      Conversation[]
  messages           Message[]

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@map("contacts")
}

model Channel {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  type           String   // "whatsapp" | "sms"
  provider       String   // "meta" | "msg91"
  wabaId         String?  @map("waba_id")
  phoneNumberId  String?  @map("phone_number_id")
  phoneNumber    String?  @map("phone_number")
  accessTokenEnc String?  @map("access_token_enc")
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  templates     Template[]
  campaigns     Campaign[]
  conversations Conversation[]

  @@index([workspaceId])
  @@map("channels")
}

model Template {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  channelId          String   @map("channel_id")
  providerName       String   @map("provider_name")
  providerTemplateId String?  @map("provider_template_id")
  language           String   @default("en_US")
  category           String
  bodyPreview        String   @map("body_preview")
  variableCount      Int      @default(0) @map("variable_count")
  status             String   @default("draft")
  rejectionReason    String?  @map("rejection_reason")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  channel   Channel    @relation(fields: [channelId], references: [id])
  campaigns Campaign[]

  @@index([workspaceId])
  @@map("templates")
}

model Campaign {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  templateId      String    @map("template_id")
  channelId       String    @map("channel_id")
  name            String
  status          String    @default("draft")
  totalRecipients Int       @default(0) @map("total_recipients")
  sentCount       Int       @default(0) @map("sent_count")
  failedCount     Int       @default(0) @map("failed_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id])
  template   Template            @relation(fields: [templateId], references: [id])
  channel    Channel             @relation(fields: [channelId], references: [id])
  recipients CampaignRecipient[]

  @@index([workspaceId])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String  @id @default(cuid())
  campaignId String  @map("campaign_id")
  contactId  String  @map("contact_id")
  messageId  String? @map("message_id")
  status     String  @default("pending")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

model Conversation {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  contactId       String    @map("contact_id")
  channelId       String    @map("channel_id")
  lastInboundAt   DateTime? @map("last_inbound_at")
  windowExpiresAt DateTime? @map("window_expires_at")
  status          String    @default("open")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  contact   Contact   @relation(fields: [contactId], references: [id])
  channel   Channel   @relation(fields: [channelId], references: [id])
  messages  Message[]

  @@unique([contactId, channelId])
  @@index([workspaceId])
  @@map("conversations")
}

model Message {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  conversationId    String    @map("conversation_id")
  contactId         String    @map("contact_id")
  direction         String
  providerMessageId String?   @map("provider_message_id")
  body              String?
  status            String    @default("received")
  createdAt         DateTime  @default(now()) @map("created_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@unique([workspaceId, providerMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model RateCard {
  id            String   @id @default(cuid())
  country       String
  category      String
  rate          Decimal  @db.Decimal(10, 4)
  currency      String   @default("USD")
  effectiveFrom DateTime @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([country, category, effectiveFrom])
  @@map("rate_card")
}

model MessageCost {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  // Note: MessageCost.messageId does NOT have a formal @relation to any existing "Message"
  // table for outbound campaign/template sends, because campaigns currently track sends via
  // CampaignRecipient + Campaign, not a row in the Message model (Message is currently only
  // used by the Conversation/inbound-webhook feature). For this pass, messageId stores the
  // providerMessageId (Meta's own message ID) as a plain string — not a foreign key — since
  // there is no single unified outbound message table yet linking campaign sends and
  // conversation sends together. This is a known simplification, not a silent decision.
  messageId    String   @unique @map("message_id")
  category     String
  rateAtSend   Decimal  @map("rate_at_send") @db.Decimal(10, 4)
  billedAmount Decimal  @map("billed_amount") @db.Decimal(10, 4)
  currency     String   @default("USD")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("message_costs")
}


